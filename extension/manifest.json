{
  "manifest_version": 3,
  "name": "FeedMerge capture",
  "version": "0.3.0",
  "description": "Saves the feed posts you scroll past on X, YouTube, TikTok, Facebook, Instagram, Threads, Bluesky and Reddit to your local FeedMerge store.",
  "permissions": ["storage", "alarms", "unlimitedStorage", "background"],
  "host_permissions": ["http://127.0.0.1:4747/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "FeedMerge", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*", "https://www.tiktok.com/*",
        "https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.instagram.com/*", "https://www.threads.com/*", "https://www.threads.net/*", "https://bsky.app/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*", "https://www.tiktok.com/*",
        "https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.instagram.com/*", "https://www.threads.com/*", "https://www.threads.net/*", "https://bsky.app/*",
        "https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
